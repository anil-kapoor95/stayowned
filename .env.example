# Absolute production origin used for canonical URLs, sitemap, robots and Open Graph.
# Leave empty during development: canonical tags and absolute sitemap URLs are then omitted.
NEXT_PUBLIC_SITE_URL=

# URL of api.php in the PHP back end (Rental Property Booking script), e.g.
# http://localhost/RentalProperty/api.php — add this site's origin to $allowed_origins in api.php.
NEXT_PUBLIC_API_URL=

# "Continue with Google": OAuth 2.0 Client ID (Web application) from Google Cloud Console > APIs & Services >
# Credentials, with this site's origin (e.g. http://localhost:3000) under "Authorized JavaScript origins".
# Empty: the back end's app/config/google.php is used; both empty hides the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=11794092662-fdap1o3c1be99hdu17j64j5vgth9fg19.apps.googleusercontent.com
